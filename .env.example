# Copy this file to .env (same folder) and fill in the values.
# .env is git-ignored: NEVER commit real credentials.
# Get the values from the Neon console: Team 3 Project 3 -> Connect
# (pick the "dev" branch for local work, connection pooling off).

# Used by the Java code (src/team-3-project-1/gui/DbSetup.java)
DB_URL=jdbc:postgresql://<neon-host>/neondb?sslmode=require
DB_USER=<neon-user>
DB_PASSWORD=<neon-password>

# Customer Flask app. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
CUSTOMER_SECRET_KEY=<random-secret>
# Set true on HTTPS hosting; leave false only for localhost development.
CUSTOMER_SECURE_COOKIE=false
# Manager PIN for /manager pages of the web app. Change it for any hosted deployment.
MANAGER_PIN=<4-digit-pin>
# Timezone used for order dates/times and "today" in reports (matches the Java app's laptop clock).
POS_TIMEZONE=America/Chicago
# Google OAuth web application credentials (guest ordering works without these).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an authorized redirect URI in your Google OAuth app.
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback
